# Copy to .env next to the KitsuFlowBOT Assistant executable, or let the app's Save buttons
# create it. Keep .env private: it holds your device key and RCON password.

# Connection (Studio → Voice & Clips → Pair a PC gives the device key)
KITSUFLOW_URL=https://kitsuflowbot.nekosunevr.co.uk
KITSUFLOW_DEVICE_KEY=
KITSUFLOW_AUTOCONNECT=true

# Voice clips
KITSUFLOW_STT_ENGINE=whisper
KITSUFLOW_WHISPER_MODEL=auto
# auto checks the installed CTranslate2 runtime; cpu forces int8; cuda needs a supported GPU.
KITSUFLOW_WHISPER_BACKEND=auto
KITSUFLOW_VOSK_MODEL=model/vask
KITSUFLOW_MIC_DEVICE=
KITSUFLOW_MIC_NAME=
KITSUFLOW_SHOW_ALL_MICS=false
KITSUFLOW_TRIGGER_SOUND=true

# Beat Saber song requests (PC): the game folder that contains "Beat Saber_Data"
KITSUFLOW_BSR_ENABLED=false
KITSUFLOW_BEATSABER_DIR=

# Minecraft Interactive (RCON, see server.properties: enable-rcon, rcon.port, rcon.password)
KITSUFLOW_MC_ENABLED=false
KITSUFLOW_MC_HOST=127.0.0.1
KITSUFLOW_MC_PORT=25575
KITSUFLOW_MC_PASSWORD=
KITSUFLOW_MC_PLAYER=
