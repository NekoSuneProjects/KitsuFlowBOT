{
  "name": "kitsuflowbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check-syntax.mjs",
    "format": "prettier --write \"server.js\" \"src/**/*.js\" \"public/**/*.{html,css,js}\" scripts",
    "format:check": "prettier --check \"server.js\" \"src/**/*.js\" \"public/**/*.{html,css,js}\" scripts"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "connect-sqlite3": "^0.9.15",
    "ws": "^8.18.1",
    "dotenv": "^16.4.7",
    "tiktok-live-connector": "^2.5.0",
    "socket.io-client": "^4.8.1"
  }
}
