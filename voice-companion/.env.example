# Copy to .env next to KitsuFlowVoiceCompanion executable.
# The application can also save these settings from its GUI.
KITSUFLOW_URL=https://kitsuflowbot.nekosunevr.co.uk
KITSUFLOW_DEVICE_KEY=
KITSUFLOW_VOSK_MODEL=model/vask
KITSUFLOW_MIC_DEVICE=
KITSUFLOW_STT_ENGINE=whisper
KITSUFLOW_WHISPER_MODEL=auto
# Play two confirmation tones when the configured phrase is recognised.
KITSUFLOW_TRIGGER_SOUND=true

# GUI preferences, preserved when reopening the desktop companion.
KITSUFLOW_SHOW_ALL_MICS=false
KITSUFLOW_MIC_NAME=
# Auto checks the installed CTranslate2 runtime; CPU forces int8, CUDA requires supported GPU.
KITSUFLOW_WHISPER_BACKEND=auto
