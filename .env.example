PORT=3000
BASE_URL=http://localhost:3000
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SESSION_SECRET=change-me-to-a-long-random-value
TOKEN_KEY=64_HEX_CHARACTERS_FROM_openssl_rand_hex_32
BOT_ADMIN_TWITCH_IDS=12345678,23456789
# Legacy single-admin fallback: BOT_ADMIN_TWITCH_ID=

# Set the same random 24+ char secret for both API and voice-worker containers.
VOICE_WORKER_SECRET=
VOICE_MAX_CHANNELS=1

# Kick OAuth app from https://dev.kick.com
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# VPZone OAuth 2.1 app from https://vpzone.tv/developers/oauth
VPZONE_CLIENT_ID=
VPZONE_CLIENT_SECRET=

# Kick config from StreamBOT/backendlive (avoid granting unused high-risk scopes)
KICK_AUTH_SCOPES=user:read channel:read channel:write chat:write events:subscribe moderation:ban
KICK_WEBHOOK_ENABLED=true
# Legacy Pusher configuration for reference; not activated by this branch.
KICK_PUSHER_URL=wss://ws-us2.pusher.com/app/32cbd69e4b950bf97679?protocol=7&client=js&version=8.4.0&flash=false
KICK_DEBUG_MESSAGES=false
KICK_DEBUG_RAW_MESSAGES=false
# Chat relay is controlled per creator in Studio, all directions OFF by default.

# Stream title AI assistant (OpenAI-compatible /v1/chat/completions API).
# This URL is the COMPLETE chat-completions endpoint, NOT just /v1.
# Supports OpenAI-compatible gateways (Omni, LiteLLM, etc.) and Ollama.
# Server-only defaults; channel-specific dashboard provider settings override these.
AI_TITLE_API_URL=http://ollama:11434/v1/chat/completions
AI_TITLE_MODEL=llama3.1:8b
# Optional for local Ollama; required if your gateway authenticates requests.
AI_TITLE_API_KEY=
# With Docker Compose, use a reachable service name or host.docker.internal
# (on Linux host.docker.internal may require extra_hosts host-gateway mapping).
# Example gateway:
# AI_TITLE_API_URL=https://your-omni-host.example/v1/chat/completions
# AI_TITLE_MODEL=your-gateway-model
# AI_TITLE_API_KEY=your-gateway-token

# Optional free self-hosted Kokoro OpenAI-compatible speech service.
# Accessible from the KitsuFlowBOT container; no public browser URL needed.
# KOKORO_TTS_URL=http://kokoro:8000/v1/audio/speech
